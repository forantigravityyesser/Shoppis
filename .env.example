# Фронт (Vite). Скопировать в .env, значения взять из BotFather / InsForge.
VITE_INSForge_URL=https://your-app.region.insforge.app
VITE_INSForge_ANON_KEY=your-anon-key
VITE_BUYER_BOT_USERNAME=buyer_bot_name_bez_sobaki
# Короткое имя именованного Mini App из BotFather (/newapp, только строчные), напр. shop.
# Формат ссылки: t.me/<bot>/<short_name>?startapp=shop_<public_id>. Пусто → Main Mini App (t.me/<bot>?startapp=...)
VITE_BUYER_APP_SHORTNAME=shop
